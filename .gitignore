# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Datasets: official raw files and processed splits are not redistributed.
# data/fixture_processed/ is a tiny SYNTHETIC test fixture and stays tracked.
data/raw/
data/fixture_raw/
data/processed/

# Trained models / checkpoints (record SHA256 hashes instead of committing them)
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Hugging Face cache
.cache/
huggingface/
models--*/

# Evaluation outputs (keep lightweight JSON/CSV/MD summaries only)
results/*
!results/*.json
!results/*.csv
!results/*.md

# Logs and temporary files
*.log
*.tmp
